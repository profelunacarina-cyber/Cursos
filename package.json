{
  "name": "profeluna-backend",
  "version": "1.0.0",
  "description": "API de cursos y resultados de evaluaciones — profeluna.ar",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env.local backend/server.js",
    "dev:local": "node --watch --env-file=.env.local backend/server.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "check:frontend": "node backend/scripts/check-frontend.js",
    "start": "node --env-file=.env.local backend/server.js",
    "start:local": "node --env-file=.env.local backend/server.js",
    "start:prod": "node --env-file=.env.production backend/server.js",
    "db:init": "node --env-file=.env.local backend/scripts/init-db.js",
    "db:init:local": "node --env-file=.env.local backend/scripts/init-db.js",
    "db:init:prod": "node --env-file=.env.production backend/scripts/init-db.js",
    "cursos:migrar": "node --env-file=.env.local backend/scripts/migrar-cursos-html.js",
    "recursos:migrar": "node --env-file=.env.local backend/scripts/migrar-recursos-html.js",
    "recursos:normalizar": "node --env-file=.env.local backend/scripts/normalizar-recursos-html.js",
    "admin:crear": "node --env-file=.env.local backend/scripts/crear-admin.js",
    "admin:crear:local": "node --env-file=.env.local backend/scripts/crear-admin.js",
    "admin:crear:prod": "node --env-file=.env.production backend/scripts/crear-admin.js",
    "smoke": "node --env-file=.env.local backend/scripts/smoke.js",
    "smoke:local": "node --env-file=.env.local backend/scripts/smoke.js",
    "smoke:prod": "node --env-file=.env.production backend/scripts/smoke.js",
    "ci:sintaxis": "node -e \"const{execSync}=require('child_process');const fs=require('fs');function w(d){return fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?(e.name==='node_modules'?[]:w(d+'/'+e.name)):(e.name.endsWith('.js')?[d+'/'+e.name]:[]))}for(const f of ['backend/server.js',...w('backend/src'),...w('backend/scripts'),...w('api')]){execSync('node --check '+f)}console.log('OK sintaxis')\"",
    "ci:boot": "node --env-file-if-exists=.env.local backend/scripts/ci-boot.js",
    "test:backend": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@primeicons/vue": "^8.0.0",
    "@vueup/vue-quill": "^1.5.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "pg": "^8.12.0",
    "read-excel-file": "^9.3.5",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
