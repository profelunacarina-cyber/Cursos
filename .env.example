# Variables de entorno para la base de datos.
# Copiar a .env.local para desarrollo o .env.production para operaciones manuales.
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
JWT_SECRET="cambia-este-secreto"
NOTA_APROBACION=60

# Recuperación de contraseña por correo (Resend).
# EMAIL_FROM debe usar un dominio verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM="Aula EPJA <aula@tudominio.com>"
