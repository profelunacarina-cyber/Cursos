# Copiá este archivo como .env y completá los valores reales.
# En Vercel estas variables se cargan en Settings → Environment Variables.

# Conexión a PostgreSQL en Neon.
# La sacás del panel de Neon (Connection string), por ejemplo:
# postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clave secreta para firmar los tokens de sesión del admin.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcionales
PORT=3000
JWT_EXPIRA=8h
NOTA_APROBACION=60
# Orígenes extra permitidos para CORS, separados por coma
# ORIGENES_PERMITIDOS=https://otrodominio.com
